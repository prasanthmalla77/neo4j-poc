# Neo4j Connection Configuration
# Copy this file to .env and update with your credentials

REACT_APP_NEO4J_URI=bolt://localhost:7687
REACT_APP_NEO4J_USERNAME=neo4j
REACT_APP_NEO4J_PASSWORD=your_password_here
REACT_APP_NEO4J_DATABASE=neo4j

# Set to 'true' to use real Neo4j data, 'false' to use mock data
REACT_APP_USE_REAL_NEO4J=false
